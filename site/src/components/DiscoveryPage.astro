---
import BaseLayout from '../layouts/BaseLayout.astro';import SiteHeader from './SiteHeader.astro';import SiteFooter from './SiteFooter.astro';import {getSiteLinks,type Locale} from '../data/content';import product from '../data/product.json';import pages from '../../published-pages.json';
interface Props {locale:Locale;kind:'updates'|'sitemap'}const {locale,kind}=Astro.props;const fr=locale==='fr',l=getSiteLinks(locale);const title=kind==='updates'?(fr?'Nouveautés':'What’s new'):(fr?'Plan du site':'Sitemap');
const alternates={en:`/${kind}/`,fr:`/fr/${kind}/`};
---
<BaseLayout title={`${title} | wt-sweep`} description={fr?'Guides et état des sources actuelles de wt-sweep.':'Guides and current wt-sweep source status.'} lang={locale} alternatePaths={alternates}><SiteHeader locale={locale} alternatePaths={alternates}/><main id="main-content" class="container discovery"><a class="text-link" href={l.home}>← {fr?'Accueil':'Home'}</a><h1>{title}</h1>{kind==='updates'?<><span class="release-tag">{product.published ? 'Pre-release' : 'Unreleased'} · {product.version}</span><p>{product.published ? <a href={product.releaseUrl}>{fr?'Télécharger l’alpha macOS Apple Silicon et SHA256SUMS.':'Download the macOS Apple Silicon alpha and SHA256SUMS.'}</a> : (fr?'Le numéro dans Cargo.toml désigne la version de développement ; il n’annonce pas une release publiée.':'The Cargo version identifies development sources. It does not establish a published release.')}</p><div class="discovery-grid"><article><h2>{fr?'Rapports et disque':'Reports and disk'}</h2><p>{fr?'Le rapport HTML regroupe les worktrees par repo, avec recherche, filtres, copie des chemins et thèmes clair/sombre. Les mesures disque ont leur propre périmètre et leurs budgets ; elles ne prédisent pas l’espace libérable sur APFS.':'Self-contained family reports, search, filters, path copying and light/dark themes. Scoped disk measurements, separate disk budgets and no promise of APFS recovery.'}</p><a class="text-link" href={l.report}>{fr?'Guide du rapport':'Report guide'} →</a></article><article><h2>{fr?'Reprise et lecture assistée':'Resume and assisted reading'}</h2><p>{fr?'La découverte peut reprendre sur les dossiers choisis. Les lectures de l’historique Git sont regroupées, et le repo fournit un skill pour Claude Code et Codex. Sa reconnaissance reste à vérifier dans chaque client.':'Resume explicit-root discovery, batched Git history and a bundled Claude/Codex skill. Native skill recognition remains a client-specific check.'}</p><a class="text-link" href={l.assistant}>{fr?'Guide Claude Code et Codex':'Assistant guide'} →</a></article></div><p><a class="text-link" href={l.changelog}>{fr?'Changelog complet':'Full canonical history'} →</a></p><p><a class="text-link" href={l.evidence}>{fr?'apply, sauvegarde et restauration restent indisponibles.':'apply, backup and restore remain unavailable.'}</a></p></>:<div class="discovery-grid"><article><h2>{fr?'Le produit':'The product'}</h2><ul><li><a href={l.home}>{fr?'Accueil':'Home'}</a></li><li><a href={l.updates}>{fr?'Nouveautés':'What’s new'}</a></li><li><a href="/demo/report.html">{fr?'Rapport interactif synthétique':'Synthetic interactive report'}</a></li></ul></article><article><h2>{fr?'Guides':'Guides'}</h2><ul>{pages.map(p=><li><a href={`${fr?'/fr':''}/docs/${p.slug==='index'?'':p.slug+'/'}`}>{p.title[locale]}</a></li>)}</ul></article></div>}</main><SiteFooter locale={locale}/></BaseLayout>
