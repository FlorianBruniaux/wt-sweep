---
import {getSiteLinks,type Locale} from '../data/content';
interface Props {locale:Locale} const {locale}=Astro.props;const l=getSiteLinks(locale),fr=locale==='fr';
const groups=[{title:fr?'Explorer':'Explore',links:[{label:fr?'Le rapport':'The report',href:`${l.home}#report`},{label:fr?'Démarrer':'Get started',href:`${l.home}#install`},{label:'FAQ',href:`${l.home}#faq`},{label:fr?'Plan du site':'Sitemap',href:l.sitemap}]},{title:fr?'Documentation':'Documentation',links:[{label:fr?'Installation':'Installation',href:l.install},{label:fr?'Repo de test':'Test repo demo',href:l.demo},{label:fr?'Preuves et limites':'Evidence & limits',href:l.evidence},{label:'Claude Code & Codex',href:l.assistant}]},{title:fr?'Projet':'Project',links:[{label:'GitHub',href:l.repository},{label:fr?'Nouveautés':'What’s new',href:l.updates},{label:'Changelog',href:l.changelog},{label:'FSL-1.1-ALv2',href:l.license}]}];
---
<footer class="site-footer"><div class="container"><div class="footer-brand-row"><a class="footer-brand" href={l.home}><span aria-hidden="true">&gt;_</span> wt-sweep</a><p>{fr?'Analyse locale des worktrees Git.':'Local Git worktree review.'}</p></div><div class="footer-sections">{groups.map((g,i)=><section class="footer-section" aria-labelledby={`footer-${i}`}><h2 id={`footer-${i}`}>{g.title}</h2><nav aria-label={g.title}><ul>{g.links.map(x=><li><a href={x.href}>{x.label}</a></li>)}</ul></nav></section>)}</div><div class="footer-meta"><p>{fr?'Créé par':'Built by'} <a href="https://florian.bruniaux.com/">Florian Bruniaux</a>.</p><nav aria-label={fr?'Auteur':'Author'}><ul><li><a href="https://github.com/FlorianBruniaux">GitHub</a></li><li><a href="https://florian.bruniaux.com/">Portfolio</a></li></ul></nav></div></div></footer>
