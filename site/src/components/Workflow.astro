---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {t}=getLandingView(locale);
---
<section id="workflow" class="section-tinted"><div class="container"><div class="section-heading"><p class="kicker">04 / {t('THE WORKFLOW','LE PARCOURS')}</p><h2>{t('From collection to the next check.','De la collecte à la prochaine vérification.')}</h2></div><ol class="workflow">{[[t('Choose the scope','Choisir le périmètre'),t('Explicit roots and confirmed full integration refs. No guessed default branch.','Choisissez les dossiers à parcourir et confirmez les refs d’intégration complètes. wt-sweep ne choisit pas de branche par défaut.')],[t('Collect current evidence','Collecter les preuves actuelles'),t('Run review. Add disk measurement when it helps prioritize. Budgets stay finite.','Lancez review et ajoutez les mesures disque si elles vous aident à choisir par où commencer. La collecte reste limitée par ses budgets.')],[t('Read the saved report','Lire le rapport sauvegardé'),t('Inspect verdicts, coverage and next checks. Keep JSON and the receipt alongside HTML.','Examinez les verdicts, la couverture et les contrôles à effectuer. Gardez les fichiers JSON et run.json avec le rapport HTML.')],[t('Focus the next check','Cibler la vérification suivante'),t('Narrow Git evidence with --worktree and disk scope with --disk-root. Their budgets are separate.','Utilisez --worktree pour cibler les vérifications Git et --disk-root pour les mesures disque. Ces deux collectes ont des budgets distincts.')]].map(([heading,body])=><li><h3>{heading}</h3><p>{body}</p></li>)}</ol></div></section>
