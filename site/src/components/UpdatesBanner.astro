---
import {getEntry} from 'astro:content';
import product from '../data/product.json';
import {getSiteLinks, type Locale} from '../data/content';
import {sourceUpdateDate, formatUpdateDate} from '../data/updates.mjs';
interface Props {locale:Locale}
const {locale}=Astro.props;
const fr=locale==='fr';
const label=fr?'Nouveautés':'What’s new';
const changelog=await getEntry('docs','docs/changelog');
if(!changelog?.body) throw new Error('Missing canonical changelog');
const date=sourceUpdateDate(changelog.body);
---
<aside class="updates-banner" aria-label={label}>
  <div class="container updates-banner-inner">
    <a href={getSiteLinks(locale).updates}><strong>{label}</strong><span>{fr?'Rapports, mesures disque et guides':'Reports, disk measurements and guides'}</span><span aria-hidden="true">→</span></a>
    <p><time datetime={date}>{formatUpdateDate(date,locale)}</time><span>{`v${product.version}`}</span></p>
  </div>
</aside>
