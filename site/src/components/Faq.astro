---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {l,t,questions,product}=getLandingView(locale);
---
<section id="faq"><div class="container split"><div class="section-heading"><p class="kicker">07 / FAQ</p><h2>{t('Before your first review.','Avant la première revue.')}</h2><p>{t('Current source version','Version des sources actuelles')} : <code>{product.version}</code>.<br/>{t('No published release is implied.','Aucune release publiée n’est déduite.')}</p><a class="text-link" href={l.updates}>{t('What’s new','Nouveautés')} →</a></div><div class="faq-list">{questions.map(x=><details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></div></section>
