---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {t,needs}=getLandingView(locale);
---
<section id="needs"><div class="container"><div class="section-heading"><p class="kicker">01 / {t('START WITH A QUESTION','PARTIR D’UNE QUESTION')}</p><h2>{t('A folder name tells only half the story.','Un nom de dossier ne raconte pas tout.')}</h2><p>{t('Agent sessions leave checkouts behind. Some are clean. Others still hold something worth keeping.','Les sessions d’agents laissent des checkouts derrière elles. Certains sont propres. D’autres contiennent encore du travail utile.')}</p></div><div class="triple">{needs.map((x,i)=><article class="need"><span class="number">0{i+1}</span><h3>{x.title}</h3><p>{x.text}</p><a class="text-link" href={x.link}>{x.label} <span aria-hidden="true"> →</span></a></article>)}</div></div></section>
