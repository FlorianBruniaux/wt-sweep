---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {fr,l,t}=getLandingView(locale);
---
<section class="hero"><div class="container"><div class="hero-grid"><div><div class="eyebrow"><span><i aria-hidden="true"></i>{t('READ-ONLY','LECTURE SEULE')}</span><span>macOS · CLI + HTML</span></div><h1>{fr?<>Repérez vos worktrees.<br/><span>Sachez quoi conserver.</span></>:<>Find your worktrees.<br/><span>Know what to keep.</span></>}</h1><p class="hero-copy">{t('Review the checkouts taking up disk space and the work they contain, with the evidence behind each verdict.','Examinez les checkouts qui prennent de la place et le travail qu’ils contiennent, avec les preuves qui justifient chaque verdict.')}</p><div class="actions"><a class="button button-primary" href={l.demo}>{t('Try a test repo','Essayer sur un repo de test')} <span aria-hidden="true">↗</span></a><a class="button" href="#report">{t('See the report','Voir le rapport')} <span aria-hidden="true">↓</span></a></div><p class="hero-note">{t('Runs locally without a model or worktree removal.','Fonctionne en local, sans modèle d’IA ni suppression de worktree.')}</p></div><figure class="report-window"><div class="window-bar"><span aria-hidden="true">● ● ●</span><span>report.html · {t('synthetic demo','démo synthétique')}</span></div><img class="light-capture" src="/assets/report-light.png" width="1440" height="800" alt={t('Native report showing four synthetic worktrees: three kept and one cleanup candidate.','Rapport natif de quatre worktrees synthétiques : trois à conserver et un candidat.')} fetchpriority="high"/><img class="dark-capture" src="/assets/report-dark.png" width="1440" height="800" alt={t('The same native report in dark theme.','Le même rapport natif en thème sombre.')} fetchpriority="high"/><figcaption>{t('Report capture · 8 Oct 2026 · worktree use still to check.','Capture du rapport · 8 oct. 2026 · utilisation du worktree à vérifier.')}</figcaption></figure></div><div class="proof-strip"><span><strong>Git</strong> · {t('explicit targets','cibles explicites')}</span><span><strong>HTML</strong> · {t('offline report','rapport hors ligne')}</span><span><strong>APFS</strong> · {t('measured size ≠ recoverable space','taille mesurée ≠ espace récupérable')}</span></div></div></section>
