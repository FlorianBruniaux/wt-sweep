---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {l,t,product,buildCommand,assistantPrompts}=getLandingView(locale);
---
<section id="install"><div class="container"><div class="section-heading"><p class="kicker">05 / {t('GET STARTED','DÉMARRER')}</p><h2>{t('Start with a temporary test repo.','Commencez sur un repo de test.')}</h2><p>{t('Build from source and run the documented demo to see how a local note changes the verdict.','Compilez les sources et lancez la démo pour voir comment une note locale change le verdict.')}</p></div><div class="split"><article class="install-panel"><span class="number">CLI / macOS</span><h3>{t('Your terminal, one report','Analyser depuis le terminal')}</h3><p>{t('From the wt-sweep checkout, with the pinned Rust toolchain.','Depuis le checkout wt-sweep, avec la version de Rust indiquée dans rust-toolchain.toml.')} ({product.rust}).</p>{product.published && <p><a class="text-link" href={product.releaseUrl}>{t('Download the Apple Silicon alpha','Télécharger l’alpha Apple Silicon')} →</a><br/>{t('Or build from source:','Ou compiler depuis les sources :')}</p>}<pre><code>{buildCommand}</code></pre><div class="copy-row"><button type="button" data-copy-command={buildCommand} aria-controls="command-status">{t('Copy commands','Copier les commandes')}</button><span id="command-status" class="copy-status" role="status" aria-live="polite"></span></div><p class="muted">{t('The first command downloads locked dependencies; skip it when they are cached. The public repo can be cloned over HTTPS.','La première commande télécharge les dépendances du lockfile ; omettez-la si elles sont en cache. Le repo public peut être cloné en HTTPS.')}</p><a class="text-link" data-doc-start href={l.install}>{t('Installation and prerequisites','Installation et prérequis')} →</a><br/><a class="text-link" href={l.demo}>{t('Run the test repo demo','Lancer la démo sur un repo de test')} →</a></article><article class="install-panel"><span class="number">CLAUDE CODE / CODEX</span><h3>{t('Read the evidence with an assistant','Lire les preuves avec un assistant')}</h3><p>{t('Open your session in the wt-sweep checkout containing the bundled skill. The CLI remains the source of verdicts.','Ouvrez votre session dans le checkout wt-sweep qui contient le skill. L’assistant lit les verdicts calculés par la CLI.')}</p><pre><code>{assistantPrompts[locale]}</code></pre><div class="copy-row"><button type="button" data-copy-prompt={assistantPrompts[locale]} aria-controls="prompt-status">{t('Copy the demo prompt','Copier le prompt de démo')}</button><span id="prompt-status" class="copy-status" role="status" aria-live="polite"></span></div><p class="muted">{t('Codex: $wt-sweep. Claude Code: /wt-sweep. Native discovery depends on the client and project trust.','Codex : $wt-sweep. Claude Code : /wt-sweep. La reconnaissance du skill dépend du client et de la confiance accordée au projet.')}</p><a class="text-link" href={l.assistant}>{t('Assistant guide','Guide Claude Code et Codex')} →</a></article></div></div></section>
