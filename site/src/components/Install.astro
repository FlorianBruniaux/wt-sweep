---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {l,t,product,buildCommand,assistantPrompts}=getLandingView(locale);
---
<section id="install"><div class="container"><div class="section-heading"><p class="kicker">05 / {t('GET STARTED','DÉMARRER')}</p><h2>{t('Try it on work you can throw away.','Commencez sur un dépôt jetable.')}</h2><p>{t('Build from the source checkout, then run the documented demo. Watch a local note change the verdict.','Compilez depuis le checkout source, puis lancez la démo documentée. Observez une note locale changer le verdict.')}</p></div><div class="split"><article class="install-panel"><span class="number">CLI / macOS</span><h3>{t('Your terminal, one report','Votre terminal, un rapport')}</h3><p>{t('From the wt-sweep checkout, with the pinned Rust toolchain.','Depuis le checkout wt-sweep, avec le toolchain Rust fixé.')} ({product.rust}).</p><pre><code>{buildCommand}</code></pre><div class="copy-row"><button type="button" data-copy-command={buildCommand} aria-controls="command-status">{t('Copy commands','Copier les commandes')}</button><span id="command-status" class="copy-status" role="status" aria-live="polite"></span></div><p class="muted">{t('The first command downloads locked dependencies. Skip it when they are cached. Repository access is required while private.','La première commande télécharge les dépendances fixées. Omettez-la si elles sont en cache. L’accès au dépôt est requis tant qu’il est privé.')}</p><a class="text-link" data-doc-start href={l.install}>{t('Installation and prerequisites','Installation et prérequis')} →</a><br/><a class="text-link" href={l.demo}>{t('Run the disposable demo','Lancer la démo jetable')} →</a></article><article class="install-panel"><span class="number">CLAUDE CODE / CODEX</span><h3>{t('Read the evidence with an assistant','Lire les preuves avec un assistant')}</h3><p>{t('Open your session in the wt-sweep checkout containing the bundled skill. The CLI remains the source of verdicts.','Ouvrez votre session dans le checkout wt-sweep contenant le skill fourni. La CLI reste la source des verdicts.')}</p><pre><code>{assistantPrompts[locale]}</code></pre><div class="copy-row"><button type="button" data-copy-prompt={assistantPrompts[locale]} aria-controls="prompt-status">{t('Copy the demo prompt','Copier le prompt de démo')}</button><span id="prompt-status" class="copy-status" role="status" aria-live="polite"></span></div><p class="muted">{t('Codex: $wt-sweep. Claude Code: /wt-sweep. Native discovery depends on the client and project trust.','Codex : $wt-sweep. Claude Code : /wt-sweep. La découverte native dépend du client et de la confiance accordée au projet.')}</p><a class="text-link" href={l.assistant}>{t('Assistant guide','Guide assistant')} →</a></article></div></div></section>
