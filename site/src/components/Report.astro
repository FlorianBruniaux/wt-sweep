---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {l,t}=getLandingView(locale);
---
<section class="section-tinted" id="report"><div class="container split"><div><div class="section-heading"><p class="kicker">02 / {t('THE REPORT','LE RAPPORT')}</p><h2>{t('Review worktrees by project.','Examinez les worktrees par projet.')}</h2><p>{t('Open the HTML report to find a Git family, read its verdicts and inspect the evidence in its detail sections.','Ouvrez le rapport HTML pour retrouver un repo et ses worktrees, lire les verdicts et consulter les preuves dans les sections de détail.')}</p></div><ul class="detail-list"><li><span aria-hidden="true">01</span><div><strong>{t('Grouped by project','Regroupé par projet')}</strong><p>{t('Search or copy paths, filter verdicts and sort worktrees by measured size.','Recherchez ou copiez un chemin, filtrez les verdicts et triez les worktrees par taille mesurée.')}</p></div></li><li><span aria-hidden="true">02</span><div><strong>{t('Evidence stays attached','Les motifs de chaque verdict')}</strong><p>{t('Files, index, history, missing conditions and collection gaps remain readable.','Consultez les fichiers, l’index, l’historique Git, les conditions manquantes et les limites rencontrées pendant la collecte.')}</p></div></li><li><span aria-hidden="true">03</span><div><strong>{t('Totals keep their scope','Le périmètre de chaque total')}</strong><p>{t('Source review, CLI selection and browser filters are separate views.','Le rapport distingue les données de l’analyse complète, la sélection CLI et les filtres du navigateur.')}</p></div></li></ul><div class="actions" style="margin-top:1.5rem"><a class="button button-primary" href="/demo/report.html" target="_blank" rel="noopener">{t('Open the interactive demo','Ouvrir la démo interactive')} <span aria-hidden="true">↗</span></a><a class="text-link" href={l.report}>{t('Report guide','Guide du rapport')}</a></div><p class="hero-note">{t('Synthetic fixtures only. Dated captures do not demonstrate later disk targeting or discovery checkpoints.','Ces captures proviennent de repos de test. Elles ne montrent pas le ciblage disque ni les checkpoints ajoutés après leur création.')} <a href="/assets/report-captures.json">{t('Capture record','Relevé des captures')}</a></p></div><figure class="report-window"><div class="window-bar"><span>{t('Evidence, row by row','Les preuves, ligne par ligne')}</span><span>HTML</span></div><img class="light-capture report-detail" src="/assets/report-details-light.png" width="1136" height="1427" loading="lazy" alt={t('Expanded evidence for the synthetic Git family.','Sections de détail ouvertes pour le repo de test et ses worktrees.')}/><img class="dark-capture report-detail" src="/assets/report-details-dark.png" width="1136" height="1427" loading="lazy" alt={t('Expanded evidence in dark theme.','Sections de détail ouvertes en thème sombre.')}/><figcaption>{t('Verdicts and their reasons from the same test fixture.','Les verdicts et leurs motifs, sur le même repo de test.')}</figcaption></figure></div></section>
