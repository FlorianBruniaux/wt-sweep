---
import type {Locale} from '../data/content';
import {getLandingView} from '../data/landing';
interface Props {locale:Locale}
const {locale}=Astro.props;
const {l,t}=getLandingView(locale);
---
<section class="section-tinted" id="report"><div class="container split"><div><div class="section-heading"><p class="kicker">02 / {t('THE REPORT','LE RAPPORT')}</p><h2>{t('From a pile of paths to a review you can read.','Des chemins dispersés à une revue lisible.')}</h2><p>{t('Open one HTML file. Find a family, read its verdicts and unfold the evidence when you need it.','Ouvrez un fichier HTML. Retrouvez une famille, lisez ses verdicts et dépliez les preuves au besoin.')}</p></div><ul class="detail-list"><li><span aria-hidden="true">01</span><div><strong>{t('Grouped by project','Regroupé par projet')}</strong><p>{t('Search paths, filter verdicts, sort measured size and copy a path.','Recherchez un chemin, filtrez les verdicts, triez la taille mesurée et copiez un chemin.')}</p></div></li><li><span aria-hidden="true">02</span><div><strong>{t('Evidence stays attached','Les preuves restent liées')}</strong><p>{t('Files, index, history, missing conditions and collection gaps remain readable.','Fichiers, index, historique, conditions manquantes et lacunes de collecte restent lisibles.')}</p></div></li><li><span aria-hidden="true">03</span><div><strong>{t('Totals keep their scope','Des totaux avec leur périmètre')}</strong><p>{t('Source review, CLI selection and browser filters are separate views.','Revue source, sélection CLI et filtres du navigateur sont des vues distinctes.')}</p></div></li></ul><div class="actions" style="margin-top:1.5rem"><a class="button button-primary" href="/demo/report.html" target="_blank" rel="noopener">{t('Open the interactive demo','Ouvrir la démo interactive')} <span aria-hidden="true">↗</span></a><a class="text-link" href={l.report}>{t('Report guide','Guide du rapport')}</a></div><p class="hero-note">{t('Synthetic fixtures only. Dated captures do not demonstrate later disk targeting or discovery checkpoints.','Fixtures synthétiques uniquement. Les captures datées ne démontrent pas le ciblage disque ni les checkpoints ajoutés ensuite.')} <a href="/assets/report-captures.json">{t('Capture record','Relevé des captures')}</a></p></div><figure class="report-window"><div class="window-bar"><span>{t('Evidence, row by row','Les preuves, ligne par ligne')}</span><span>HTML</span></div><img class="light-capture report-detail" src="/assets/report-details-light.png" width="1136" height="1427" loading="lazy" alt={t('Expanded evidence for the synthetic Git family.','Preuves dépliées de la famille Git synthétique.')}/><img class="dark-capture report-detail" src="/assets/report-details-dark.png" width="1136" height="1427" loading="lazy" alt={t('Expanded evidence in dark theme.','Preuves dépliées en thème sombre.')}/><figcaption>{t('Same fixture. Every verdict keeps its reasons.','Même fixture. Chaque verdict conserve ses motifs.')}</figcaption></figure></div></section>
